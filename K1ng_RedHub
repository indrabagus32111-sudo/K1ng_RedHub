    if not chasingplayer then return end
    
    notify("Child Actions", "Sending child...")

    if not Workspace:FindFirstChild(LocalPlayer.Name) or not Workspace[LocalPlayer.Name]:FindFirstChild("FollowCharacter") then
        local args = { "CharacterFollowSpawnPlayer", "BabyBoy" }
        pcall(function()
            ReplicatedStorage.RE:FindFirstChild("1Bab1yFollo1w"):FireServer(unpack(args))
        end)
    end
    
    task.wait(0.2)
    
    if Workspace:FindFirstChild(LocalPlayer.Name) then
        for _, v in pairs(Workspace[LocalPlayer.Name]:GetChildren()) do
            if v:IsA("BasePart") then
                v.CanCollide = true
            end
        end
    end

    local target = chasingplayer
    if Workspace:FindFirstChild(target) and Workspace:FindFirstChild(LocalPlayer.Name) and Workspace[LocalPlayer.Name]:FindFirstChild("FollowCharacter") then
        Workspace[LocalPlayer.Name].FollowCharacter.Parent = Workspace[target]

        if rawget(getgenv(), "ChildRunService") then return end

        getgenv().ChildRunService = RunService.Heartbeat:Connect(function()
            local targetWorkspace = Workspace:FindFirstChild(target)
            if not targetWorkspace then return end
            
            local followCharacter = targetWorkspace:FindFirstChild("FollowCharacter")
            if followCharacter and followCharacter:FindFirstChild("Torso") and followCharacter.Torso:FindFirstChild("BodyPosition") then
                local humanoidRootPart = targetWorkspace:FindFirstChild("HumanoidRootPart")
                if humanoidRootPart then
                    followCharacter.Torso.BodyPosition.Position = humanoidRootPart.Position - (humanoidRootPart.CFrame.LookVector * 3)
                    followCharacter.Torso.BodyGyro.CFrame = humanoidRootPart.CFrame
                end
            end
        end)
    end
end})

