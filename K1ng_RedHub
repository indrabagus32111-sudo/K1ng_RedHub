local function updateUI(player, char)
    if not BillboardState.enabled then return end
    local state = BillboardState.uis[player]
    if not (state and state.main) then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.MaxHealth > 0 then
        local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        state.main.HealthBar.Fill.Size = UDim2.fromScale(ratio, 1)
        state.main.HealthBar.Fill.BackgroundColor3 = Color3.fromHSV(ratio / 3, 0.8, 0.9)
    end
    local pData = CONFIG.platforms[getPlayerPlatform(player) or "Unknown"]
    state.main.PlatformIcon.Image = pData[1]
    state.main.PlatformIcon.ImageColor3 = pData[2]
    local scroller = state.main.Backpack
    for _, child in ipairs(scroller:GetChildren()) do
        if child:IsA("ImageButton") or (child:IsA("TextLabel") and child.Name == "EmptyLabel") then
            child:Destroy()
        end
    end
    local count = 0
    local equipped = char:FindFirstChildWhichIsA("Tool")
    if equipped then
        count = count + 1
        local icon = Instance.new("ImageButton")
        icon.Name = equipped.Name
        icon.BackgroundTransparency = 1
        icon.Image = equipped.TextureId or ""
        icon.ScaleType = Enum.ScaleType.Fit
        icon.Parent = scroller
        local border = Instance.new("UIStroke")
        border.Color = Color3.fromRGB(255, 80, 80)
        border.Thickness = 2.5
        border.Transparency = 0.2
        border.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        border.Parent = icon
        icon.MouseEnter:Connect(function()
            scroller.Tooltip.Text = equipped.Name
            scroller.Tooltip.Visible = true
        end)
        icon.MouseLeave:Connect(function()
            scroller.Tooltip.Visible = false
        end)
        icon.MouseButton1Click:Connect(function()
            if equipped and equipped.Parent == char then
                equipped:Clone().Parent = lp.Backpack
            end
        end)
    end
    for _, tool in ipairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            count = count + 1
            local icon = Instance.new("ImageButton")
            icon.Name = tool.Name
            icon.BackgroundTransparency = 1
            icon.Image = tool.TextureId or ""
            icon.ScaleType = Enum.ScaleType.Fit
            icon.Parent = scroller
            icon.MouseEnter:Connect(function()
                scroller.Tooltip.Text = tool.Name
                scroller.Tooltip.Visible = true
            end)
            icon.MouseLeave:Connect(function()
                scroller.Tooltip.Visible = false
            end)
            icon.MouseButton1Click:Connect(function()
                if tool and tool.Parent == player.Backpack then
                    tool:Clone().Parent = lp.Backpack
                end
            end)
        end
    end
    if count == 0 then
        local empty = Instance.new("TextLabel")
        empty.Name = "EmptyLabel"
        empty.Size = UDim2.new(1, 0, 0, 20)
        empty.BackgroundTransparency = 1
        empty.Text = "No tools"
        empty.TextColor3 = Color3.fromRGB(120, 120, 130)
        empty.TextSize = 12
        empty.Font = Enum.Font.SourceSansItalic
        empty.Parent = scroller
    end
end

rs.Heartbeat:Connect(function()
