        if plr == lp then continue end
        local state = BillboardState.uis[plr] or createElements(plr)
        local target = plr.Character
        if target and target.PrimaryPart and target:FindFirstChild("Head") then
            local dist = (pos - target.PrimaryPart.Position).Magnitude
            if dist <= CONFIG.distance then
                state.gui.Adornee = target.Head
                if state.currentState == "hidden" then
                    state.currentState = "visible"
                    state.gui.Parent = getParentGUI()
                    animate(state, "in")
                end
                updateUI(plr, target)
            else
                if state.currentState == "visible" then
                    state.currentState = "hidden"
                    local t = animate(state, "out")
                    task.delay(CONFIG.animTime + 0.05, function()
                        if state.currentState == "hidden" then
                            state.gui.Parent = nil
                        end
                    end)
                end
            end
        elseif state.currentState == "visible" then
            state.currentState = "hidden"
            state.gui.Parent = nil
        end
    end
end)

